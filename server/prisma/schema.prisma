generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  ANALYST
  DEVOPS
}

enum RuleType {
  RATE_LIMIT
  IP_ALLOWLIST
  AUTH_REQUIRED
  PAYLOAD_VALIDATION
}

enum PolicyStatus {
  ACTIVE
  INACTIVE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum ConnectionStatus {
  ALLOWED
  BLOCKED
  PENDING_REVIEW
}

model User {
  id            Int              @id @default(autoincrement())
  name          String
  email         String           @unique
  passwordHash  String           @map("password_hash")
  role          RoleName
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  policies      SecurityPolicy[]
  auditLogs     AuditLog[]
  microservices Microservice[]

  @@map("users")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        RoleName     @unique
  description String?
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id       Int    @id @default(autoincrement())
  roleId   Int    @map("role_id")
  resource String
  action   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action], name: "roleId_resource_action")
  @@map("permissions")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model SecurityPolicy {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  ruleType    RuleType     @map("rule_type")
  ruleConfig  Json         @map("rule_config")
  status      PolicyStatus @default(ACTIVE)
  createdBy   Int          @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  creator     User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@map("security_policies")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model Microservice {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  description  String?
  ownerId      Int           @map("owner_id")
  baseUrl      String        @map("base_url")
  status       ServiceStatus @default(ACTIVE)
  healthStatus HealthStatus  @default(HEALTHY) @map("health_status")
  tags         Json          @default("[]")
  registeredAt DateTime      @default(now()) @map("registered_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  owner               User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  identities          ServiceIdentity[]
  outgoingConnections ServiceConnection[] @relation("SourceService")
  incomingConnections ServiceConnection[] @relation("TargetService")

  @@index([ownerId])
  @@map("microservices")
}

model ServiceIdentity {
  id               Int          @id @default(autoincrement())
  serviceId        Int          @map("service_id")
  clientSecretHash String?      @map("client_secret_hash")
  issuedAt         DateTime     @default(now()) @map("issued_at")
  expiresAt        DateTime     @map("expires_at")
  revoked          Boolean      @default(false)

  service Microservice @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_identities")
}

model ServiceConnection {
  id              Int              @id @default(autoincrement())
  sourceServiceId Int              @map("source_service_id")
  targetServiceId Int              @map("target_service_id")
  protocol        String           @default("HTTP")
  status          ConnectionStatus @default(ALLOWED)
  lastSeenAt      DateTime         @default(now()) @map("last_seen_at")

  sourceService Microservice @relation("SourceService", fields: [sourceServiceId], references: [id], onDelete: Cascade)
  targetService Microservice @relation("TargetService", fields: [targetServiceId], references: [id], onDelete: Cascade)

  @@unique([sourceServiceId, targetServiceId, protocol], name: "connection_unique_link")
  @@map("service_connections")
}