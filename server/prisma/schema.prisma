generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  ANALYST
  DEVOPS
}

enum RuleType {
  RATE_LIMIT
  IP_ALLOWLIST
  AUTH_REQUIRED
  PAYLOAD_VALIDATION
}

enum PolicyStatus {
  ACTIVE
  INACTIVE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum ConnectionStatus {
  ALLOWED
  BLOCKED
  PENDING_REVIEW
}

enum ThreatRuleType {
  RATE_LIMIT_EXCEEDED
  REPEATED_AUTH_FAILURE
  UNUSUAL_ENDPOINT_ACCESS
  PAYLOAD_ANOMALY
  GEO_ANOMALY
}

enum ThreatSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ThreatStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
}

enum AttackType {
  BRUTE_FORCE
  DDOS_BURST
  CREDENTIAL_STUFFING
  SQL_INJECTION_ATTEMPT
  LATERAL_MOVEMENT
  DATA_EXFILTRATION
}

enum SimulationIntensity {
  LOW
  MEDIUM
  HIGH
}

enum SimulationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  STOPPED
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  passwordHash    String           @map("password_hash")
  role            RoleName
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  refreshTokens   RefreshToken[]
  policies        SecurityPolicy[]
  auditLogs       AuditLog[]
  microservices   Microservice[]
  resolvedThreats Threat[]         @relation("ThreatResolver")
  simulationRuns  SimulationRun[]  @relation("SimulationTriggerer")

  @@map("users")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        RoleName     @unique
  description String?
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id       Int    @id @default(autoincrement())
  roleId   Int    @map("role_id")
  resource String
  action   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action], name: "roleId_resource_action")
  @@map("permissions")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model SecurityPolicy {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  ruleType    RuleType     @map("rule_type")
  ruleConfig  Json         @map("rule_config")
  status      PolicyStatus @default(ACTIVE)
  createdBy   Int          @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  creator     User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@map("security_policies")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resource])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Microservice {
  id               Int              @id @default(autoincrement())
  name             String           @unique
  description      String?
  ownerId          Int              @map("owner_id")
  baseUrl          String           @map("base_url")
  status           ServiceStatus    @default(ACTIVE)
  healthStatus     HealthStatus     @default(HEALTHY) @map("health_status")
  isSimulationSafe Boolean          @default(true) @map("is_simulation_safe")
  tags             Json             @default("[]")
  registeredAt     DateTime         @default(now()) @map("registered_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  owner               User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  identities          ServiceIdentity[]
  outgoingConnections ServiceConnection[] @relation("SourceService")
  incomingConnections ServiceConnection[] @relation("TargetService")
  sourceTraffic       TrafficLog[]        @relation("SourceTraffic")
  targetTraffic       TrafficLog[]        @relation("TargetTraffic")
  threats             Threat[]            @relation("ServiceThreats")
  attackScenarios     AttackScenario[]

  @@index([ownerId])
  @@map("microservices")
}

model ServiceIdentity {
  id               Int          @id @default(autoincrement())
  serviceId        Int          @map("service_id")
  clientSecretHash String?      @map("client_secret_hash")
  issuedAt         DateTime     @default(now()) @map("issued_at")
  expiresAt        DateTime     @map("expires_at")
  revoked          Boolean      @default(false)

  service Microservice @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_identities")
}

model ServiceConnection {
  id              Int              @id @default(autoincrement())
  sourceServiceId Int              @map("source_service_id")
  targetServiceId Int              @map("target_service_id")
  protocol        String           @default("HTTP")
  status          ConnectionStatus @default(ALLOWED)
  lastSeenAt      DateTime         @default(now()) @map("last_seen_at")

  sourceService Microservice @relation("SourceService", fields: [sourceServiceId], references: [id], onDelete: Cascade)
  targetService Microservice @relation("TargetService", fields: [targetServiceId], references: [id], onDelete: Cascade)

  @@unique([sourceServiceId, targetServiceId, protocol], name: "connection_unique_link")
  @@map("service_connections")
}

model TrafficLog {
  id               Int      @id @default(autoincrement())
  sourceServiceId  Int?     @map("source_service_id")
  targetServiceId  Int?     @map("target_service_id")
  simulationRunId  Int?     @map("simulation_run_id")
  method           String
  endpoint         String
  statusCode       Int      @map("status_code")
  responseTimeMs   Int      @map("response_time_ms")
  requestSizeBytes Int      @map("request_size_bytes")
  ipAddress        String   @map("ip_address")
  timestamp        DateTime @default(now())

  sourceService Microservice?  @relation("SourceTraffic", fields: [sourceServiceId], references: [id], onDelete: SetNull)
  targetService Microservice?  @relation("TargetTraffic", fields: [targetServiceId], references: [id], onDelete: SetNull)
  simulationRun SimulationRun? @relation(fields: [simulationRunId], references: [id], onDelete: SetNull)

  @@index([sourceServiceId])
  @@index([targetServiceId])
  @@index([simulationRunId])
  @@index([statusCode])
  @@index([ipAddress])
  @@index([timestamp])
  @@map("traffic_logs")
}

model ThreatRule {
  id              Int            @id @default(autoincrement())
  name            String
  ruleType        ThreatRuleType @map("rule_type")
  thresholdConfig Json           @map("threshold_config")
  severity        ThreatSeverity @default(MEDIUM)
  enabled         Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at")
  threats         Threat[]

  @@map("threat_rules")
}

model Threat {
  id              Int            @id @default(autoincrement())
  ruleId          Int?           @map("rule_id")
  sourceServiceId Int?           @map("source_service_id")
  simulationRunId Int?           @map("simulation_run_id")
  ipAddress       String?        @map("ip_address")
  description     String
  severity        ThreatSeverity
  status          ThreatStatus   @default(OPEN)
  detectedAt      DateTime       @default(now()) @map("detected_at")
  resolvedAt      DateTime?      @map("resolved_at")
  resolvedBy      Int?           @map("resolved_by")

  rule          ThreatRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  sourceService Microservice?  @relation("ServiceThreats", fields: [sourceServiceId], references: [id], onDelete: SetNull)
  resolver      User?          @relation("ThreatResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  simulationRun SimulationRun? @relation(fields: [simulationRunId], references: [id], onDelete: SetNull)

  @@index([severity])
  @@index([status])
  @@index([sourceServiceId])
  @@index([simulationRunId])
  @@index([detectedAt])
  @@map("threats")
}

model AttackScenario {
  id              Int                 @id @default(autoincrement())
  name            String
  description     String?
  attackType      AttackType          @map("attack_type")
  targetServiceId Int?                @map("target_service_id")
  intensity       SimulationIntensity @default(MEDIUM)
  durationSeconds Int                 @default(30) @map("duration_seconds")
  config          Json                @map("config")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  targetService Microservice?   @relation(fields: [targetServiceId], references: [id], onDelete: SetNull)
  runs          SimulationRun[]

  @@index([attackType])
  @@map("attack_scenarios")
}

model SimulationRun {
  id             Int                 @id @default(autoincrement())
  scenarioId     Int                 @map("scenario_id")
  triggeredBy    Int                 @map("triggered_by")
  status         SimulationRunStatus @default(QUEUED)
  startedAt      DateTime            @default(now()) @map("started_at")
  endedAt        DateTime?           @map("ended_at")
  resultsSummary Json?               @map("results_summary")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  scenario    AttackScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  triggerer   User           @relation("SimulationTriggerer", fields: [triggeredBy], references: [id], onDelete: Cascade)
  trafficLogs TrafficLog[]
  threats     Threat[]

  @@index([scenarioId])
  @@index([triggeredBy])
  @@index([status])
  @@map("simulation_runs")
}